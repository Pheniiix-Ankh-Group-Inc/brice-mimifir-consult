# Toutes les variables sont optionnelles pour un déploiement Vercel temporaire.
# Décommenter SITE_URL avant l'ouverture publique avec le domaine canonique final.
# SITE_URL=https://example.com

# Décommenter les trois variables ensemble pour activer l'envoi du formulaire.
# RESEND_API_KEY=re_example
# CONTACT_TO_EMAIL=contact@example.com
# CONTACT_FROM_EMAIL=Website <website@example.com>
